<section class="hero-shop">
  <div class="hero-shop__inner">
    <div class="hero-shop__copy">
      <h1 class="hero-shop__title">
        {%- if section.settings.heading_accent != blank -%}
          {%- assign accent_html = section.settings.heading_accent | prepend: '<em>' | append: '</em>' -%}
          {{ section.settings.heading | replace: section.settings.heading_accent, accent_html }}
        {%- else -%}
          {{ section.settings.heading }}
        {%- endif -%}
      </h1>

      {% if section.settings.subheading != blank %}
        <p class="hero-shop__sub">{{ section.settings.subheading }}</p>
      {% endif %}

      <div class="hero-shop__actions">
        {% if section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="btn btn--solid btn--lg {% if settings.button_pulse %}btn--pulse{% endif %}">{{ section.settings.cta_text }}</a>
        {% endif %}
        {% if section.settings.link_text != blank %}
          <a href="{{ section.settings.link_link | default: '#section-visit' }}" class="hero-shop__link">
            {{ section.settings.link_text }}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  {%- liquid
    if section.settings.collection != blank
      assign hero_collection = section.settings.collection
    else
      assign hero_collection = collections.all
    endif
  -%}
  <div class="hero-shop__products section">
    <div class="hero-shop__products-inner">
      <div class="hero-shop__products-head">
        <span class="hero-shop__products-eyebrow">{{ section.settings.products_heading | default: 'Shop New Arrivals' }}</span>
        <div class="hero-shop__products-headright">
          <div class="slider-arrows">
            <button type="button" class="slider-arrow" data-slider-prev aria-label="Previous">&#8249;</button>
            <button type="button" class="slider-arrow" data-slider-next aria-label="Next">&#8250;</button>
          </div>
          <a href="{{ hero_collection.url | default: '/collections/all' }}" class="section__view-all">View all <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
      </div>
      <div class="product-slider hero-shop__slider" data-slider-track>
        {% for product in hero_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% else %}
          {% for i in (1..4) %}
            <div class="product-card product-card--placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'product-card__img' }}
              <div class="product-card__body">
                <div class="product-card__title">Sample product</div>
                <div class="price"><span class="price__regular">$00.00</span></div>
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  </div>

  {% if section.settings.marquee_items != blank %}
    {% assign marquee_list = section.settings.marquee_items | split: ',' %}
    <div class="hero-shop__marquee">
      <div class="hero-shop__marquee-track">
        {% for i in (1..2) %}
          {% for item in marquee_list %}
            <span>{{ item | strip }}</span>
            <span class="hero-shop__marquee-dot">&bull;</span>
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "East Village Buyers Official Online Store" },
    { "type": "text", "id": "heading_accent", "label": "Accent word/phrase in heading", "info": "Must match text in the heading exactly. Leave blank for none.", "default": "Official Online Store" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Authenticated gold, jewelry, streetwear, sneakers, and collectibles — shipped nationwide within 2 business days from our East Village shop." },
    { "type": "text", "id": "cta_text", "label": "Primary button text", "default": "Shop All Products" },
    { "type": "url", "id": "cta_link", "label": "Primary button link" },
    { "type": "text", "id": "link_text", "label": "Secondary link text", "default": "Visit Us in the East Village" },
    { "type": "url", "id": "link_link", "label": "Secondary link URL" },
    { "type": "header", "content": "Product strip" },
    { "type": "text", "id": "products_heading", "label": "Product strip eyebrow", "default": "Shop New Arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "header", "content": "Scrolling strip" },
    { "type": "text", "id": "marquee_items", "label": "Marquee items (comma-separated)", "default": "Authenticated In-Store, Fast Tracked Shipping, New Drops Weekly, Same-Day Cash Offers" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
